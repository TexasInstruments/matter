import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/openthread.gni")

import("//build_overrides/freertos.gni")

import("//build_overrides/mbedtls.gni")
import("//build_overrides/pigweed.gni")
import("//build_overrides/ti_simplelink_sdk.gni")
import("${chip_root}/src/app/icd/icd.gni")

import("${chip_root}/src/platform/device.gni")
import("${dir_pw_build}/python.gni")

import("ti_simplelink_board.gni")

if(ti_simplelink_device_family == "cc13x4_26x4" || ti_simplelink_device_family == "cc32xx" ||
   ti_simplelink_device_family == "cc27xx") {
  import("${mbedtls_root}/mbedtls.gni")
}

import("${build_root}/config/compiler/compiler.gni")

declare_args() {
  # Location of the TI SimpleLink SDK.

  if (ti_simplelink_device_family == "cc13x4_26x4") {
    ti_simplelink_sdk_root =
        "${chip_root}/third_party/ti_simplelink_sdk/repo_cc13xx_cc26xx"
  } else if (ti_simplelink_device_family == "cc32xx") {
    ti_simplelink_sdk_root =
        "${chip_root}/third_party/ti_simplelink_sdk/repo_cc32xx"
  } else if (ti_simplelink_device_family == "cc35xx") {
    ti_simplelink_sdk_root =
        "${chip_root}/third_party/ti_simplelink_sdk/repo_cc35xx"
    ti_simplelink_wifi_toolbox_root = ""
  } else if (ti_simplelink_device_family == "cc27xx") {
    ti_simplelink_sdk_root =
        "${chip_root}/third_party/ti_simplelink_sdk/repo_cc23xx_cc27xx"
  }

  ti_sysconfig_root = ""
  silk_logging_enabled = false
  enable_appoble_ota = ""
  appoble_enabled = ""

  # Thread Radio and RCL Logs enabled
  silk_logging_radio_enabled = false

  # Platform and BLE Manager Logs enabled
  silk_logging_matter_enabled = false

  # Log Sink configured to output to the XDS UART
  silk_logging_UART_enabled = false

  # Log Sink configured to output to ITM
  silk_logging_ITM_enabled = false

  # Internal
  silk_logging_TRACE_enabled = false
}

if (silk_logging_radio_enabled) {
  silk_logging_radio_enabled_str = "true"
} else {
  silk_logging_radio_enabled_str = "false"
}

if (silk_logging_matter_enabled) {
  silk_logging_matter_enabled_str = "true"
} else {
  silk_logging_matter_enabled_str = "false"
}

if (silk_logging_UART_enabled) {
  silk_logging_UART_enabled_str = "true"
} else {
  silk_logging_UART_enabled_str = "false"
}

if (silk_logging_ITM_enabled) {
  silk_logging_ITM_enabled_str = "true"
} else {
  silk_logging_ITM_enabled_str = "false"
}

if (silk_logging_TRACE_enabled) {
  silk_logging_TRACE_enabled_str = "true"
} else {
  silk_logging_TRACE_enabled_str = "false"
}
assert(ti_simplelink_sdk_root != "", "ti_simplelink_sdk_root must be specified")
assert(ti_sysconfig_root != "", "ti_sysconfig_root must be specified")

if(ti_simplelink_device_family == "cc35xx"){
  assert(ti_simplelink_wifi_toolbox_root != 
  "ti_simplelink_wifi_toolbox_root must be specified")
}

template("ti_sysconfig") {
  assert(ti_sysconfig_root != "", "must be specified")
  assert(ti_simplelink_sdk_root != "",
         "ti_simplelink_sdk_root must be specified")

  output_dir = "${target_gen_dir}/${target_name}"
  gen_outputs = []
  foreach(output, invoker.outputs) {
    gen_outputs += [ output_dir + "/" + output ]
  }

  config("cc13x4_26x4_${target_name}_config") {
    ldflags = [
      "-nostartfiles",
      "-fno-exceptions",
      "-fno-unwind-tables",
    ]
    cflags = [ "-Wno-sign-compare" ]
    if (ti_simplelink_board == "LP_EM_CC1354P10_6" ||
        ti_simplelink_board == "LP_EM_CC1354P10_1") {
      defines = [ "DeviceFamily_CC13X4" ]
    } else if (ti_simplelink_board == "LP_EM_CC2674P10" ||
               ti_simplelink_board == "CC2674R10") {
      defines = [ "DeviceFamily_CC26X4" ]
    }

  }

  config("cc32xx_${target_name}_config") {
    ldflags = [ "-nostartfiles" ]
    cflags = [ "-Wno-sign-compare" ]
    defines = [ "CC32XXWARE" ]
  }

  config("cc35xx_${target_name}_config") {
    ldflags = [ "-nostartfiles",
                "-fno-exceptions",
                "-fno-unwind-tables", 
                "-znoexecstack"          
              ]
    cflags = [ "-Wno-sign-compare" ]
    cflags_cc = ["-Wno-register"]
    defines = ["DeviceFamily_CC35XX"]
  }

  config("cc27xx_${target_name}_config") {
    ldflags = [
      "-nostartfiles",
      "-fno-exceptions",
      "-fno-unwind-tables",
      "-znoexecstack",
    ]
    cflags = [ "-Wno-sign-compare" ]
    defines = [
      "CC23X0",
    ]
    if(ti_simplelink_board == "LP_EM_CC2745R10_Q1"){
      defines += ["DeviceFamily_CC27XXX10"]
    } else if (ti_simplelink_board == "LP_EM_CC2755P20"){
      defines += ["DeviceFamily_CC27XXX20"]
    }
  }

  config("${target_name}_config") {
    include_dirs = []

    # temporary workaround to find ble_cs.h in the Matter repo
    if(ti_simplelink_device_family == "cc27xx") {
      include_dirs += [
        "${chip_root}/src/platform/ti/cc27xx",
      ]
    }

    include_dirs += [
      output_dir,
      "${ti_simplelink_sdk_root}/source",
    ]

    forward_variables_from(invoker,
                           [
                             "cflags",
                             "ldflags",
                             "cflags_c",
                           ])
    if (defined(invoker.include_dirs)) {
      include_dirs += invoker.include_dirs
    }

    configs = [ ":${ti_simplelink_device_family}_${target_name}_config" ]
  }

  pw_python_action("${target_name}_gen") {
    script = "${ti_simplelink_sdk_build_root}/run_sysconfig.py"
    sources = invoker.sources
    outputs = gen_outputs

    if (defined(invoker.rtos)) {
      rtos = invoker.rtos
    } else {
      rtos = "freertos"
    }

    if (silk_logging_enabled) {
      silk_log_define = "SL_TRUE"
    } else {
      silk_log_define = "SL_FALSE"
    }

    if (ti_simplelink_device == "") {
      args = [
        ti_sysconfig_root,
        "-s",
        rebase_path(ti_simplelink_sdk_root + "/.metadata/product.json",
                    root_build_dir),
        "-o",
        rebase_path(output_dir, root_build_dir),
        "--compiler",
        "gcc",
        "--board",
        "/ti/boards/" + ti_simplelink_board,
        "--rtos",
        rtos,
        "--scriptArgs",
        silk_log_define,
      ]
      if(ti_simplelink_device_family == "cc35xx"){
        args += [
          "-s",
          rebase_path(ti_simplelink_wifi_toolbox_root + "/.metadata/product.json",
                      root_build_dir),
        ]
      }
    } else {
      args = [
        ti_sysconfig_root,
        "-s",
        rebase_path(ti_simplelink_sdk_root + "/.metadata/product.json",
                    root_build_dir),
        "-o",
        rebase_path(output_dir, root_build_dir),
        "--compiler",
        "gcc",
        "--device",
        ti_simplelink_device,
        "--rtos",
        rtos,
        "--scriptArgs",
        silk_log_define,
      ]
    }

    foreach(source, sources) {
      args += [ rebase_path(source, root_build_dir) ]
    }
  }

  source_set(target_name) {
    sources = gen_outputs

    public_configs = [ ":${target_name}_config" ]
    public_deps = [ ":${target_name}_gen" ]

    if (defined(invoker.public_configs)) {
      public_configs += invoker.public_configs
    }
  }
}

template("ti_simplelink_sdk") {
  assert(ti_simplelink_sdk_root != "",
         "ti_simplelink_sdk_root must be specified")

  if (ti_simplelink_device_family == "cc13x4_26x4" ||
      ti_simplelink_device_family == "cc27xx") {
    if (ti_simplelink_device_family == "cc13x4_26x4") {
      driverlibDir = "bin"
      driverlibExt = "lib"
    } else if (ti_simplelink_device_family == "cc27xx") {
      driverlibDir = "lib"
      driverlibExt = "a"
    }

    action("build_external_library") {
      script = "${ti_simplelink_sdk_build_root}/run_sdk_drivers_gen.py"
      outputs = [
        "${target_gen_dir}/drivers_${ti_simplelink_soc_family}.a",
        "${target_gen_dir}/driverlib." + driverlibExt,
      ]

      args = [
        "--sdk",
        rebase_path(ti_simplelink_sdk_root),
        "--chip-root",
        rebase_path(chip_root),
        "--src-path-drivers",
        "/source/ti/drivers/lib/gcc/${ti_simplelink_isa}/drivers_${ti_simplelink_soc_family}.a",
        "--src-path-driverlib",
        "/source/ti/devices/${ti_simplelink_device_family_driverlib}/driverlib/" + driverlibDir + "/gcc/driverlib." + driverlibExt,
        "--dest-path",
        rebase_path(target_gen_dir),
      ]

      if (ti_simplelink_device_family == "cc27xx" && ti_simplelink_board == "LP_EM_CC2745R10_Q1") {

        outputs += [ "${target_gen_dir}/secure_drivers_cc27xxx10.a" , "${target_gen_dir}/hsmddk_cc27xxx10_its.a" ]

        args += [
            "--src-path-hsm",
         "/source/third_party/hsmddk/lib/gcc/m33f/hsmddk_cc27xxx10_its.a",
          "--secure-src-file",
          "/source/ti/drivers/secure/lib/gcc/${ti_simplelink_isa}/secure_drivers_cc27xxx10.a",
          "--secure-dest-path",
          rebase_path(target_gen_dir),
        ]
      } else if (ti_simplelink_device_family == "cc27xx" && ti_simplelink_board == "LP_EM_CC2755P20") {
        outputs += [ "${target_gen_dir}/secure_drivers_cc27xxx20.a" , "${target_gen_dir}/hsmddk_cc27xxx20_its.a" ]
         args += [
            "--src-path-hsm",
         "/source/third_party/hsmddk/lib/gcc/m33f/hsmddk_cc27xxx20_its.a",
          "--secure-src-file",
          "/source/ti/drivers/secure/lib/gcc/${ti_simplelink_isa}/secure_drivers_cc27xxx20.a",
          "--secure-dest-path",
          rebase_path(target_gen_dir),
        ]
      }
    }
  }
  if (defined(invoker.ti_simplelink_sdk_root)) {
    ti_simplelink_sdk_root = invoker.ti_simplelink_sdk_root
  }

  sdk_target_name = target_name

  config("cc13x4_26x4_sdk_config") {
    libs = [ "${ti_simplelink_sdk_root}/source/ti/drivers/rf/lib/gcc/${ti_simplelink_isa}/rf_multiMode_${ti_simplelink_soc_family}.a" ]
    defines = [ "FLASH_ONLY_BUILD" ]
    if (ti_simplelink_board == "LP_EM_CC1354P10_1" ||
        ti_simplelink_board == "LP_EM_CC1354P10_6") {
      defines += [ "DeviceFamily_CC13X4" ]
    } else if (ti_simplelink_board == "LP_EM_CC2674P10" ||
               ti_simplelink_board == "CC2674R10") {
      defines += [ "DeviceFamily_CC26X4" ]
    }
    if (ti_simplelink_board == "LP_EM_CC1354P10_1" ||
        ti_simplelink_board == "CC2674R10") {
      defines += [ "EM_CC1354P10_1_LP" ]
    }

    if (ti_simplelink_device_family == "cc13x4_26x4") {
      if (silk_logging_enabled) {
        libs += [ "${ti_simplelink_sdk_root}/source/ti/log/lib/gcc/${ti_simplelink_isa}/log_${ti_simplelink_soc_family}.a" ]
      }
    }
  }

  config("cc27xx_sdk_config") {
    defines = [ "FLASH_ONLY_BUILD" ]
    if (ti_simplelink_device == "") {
      defines += [
        "CC23X0",
      ]

      if(ti_simplelink_board == "LP_EM_CC2745R10_Q1"){
      defines += ["DeviceFamily_CC27XXX10"]
      } else if (ti_simplelink_board == "LP_EM_CC2755P20"){
      defines += ["DeviceFamily_CC27XXX20"]
      }
    }

    ldflags = ["-fno-lto"]
  }

  config("cc32xx_sdk_config") {
    defines = [ "DeviceFamily_CC3220" ]

    libs = [
      "${ti_simplelink_sdk_root}/source/ti/drivers/lib/gcc/m4/drivers_cc32xx.a",
      "${ti_simplelink_sdk_root}/source/ti/devices/cc32xx/driverlib/gcc/Release/driverlib.a",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/gcc/rtos/simplelink.a",
      "${ti_simplelink_sdk_root}/source/ti/net/lib/gcc/m4/slnetsock_debug.a",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/slnetif/gcc/Release/slnetifwifi.a",
      "${ti_simplelink_sdk_root}/source/ti/drivers/lib/gcc/m4/drivers_${ti_simplelink_soc_family}.a",
    ]
    include_dirs = [
      "${ti_simplelink_sdk_root}/examples/rtos/common/",
      "${ti_simplelink_sdk_root}/examples/rtos/common/ifmod",
    ]
  }

  config("cc35xx_sdk_config") {
    defines = [ "RAM_CONTAINER",
                "CC35XX", 
                ]

    libs = [
      "${ti_simplelink_sdk_root}/source/ti/drivers/lib/gcc/m33f/drivers_cc35xx.a",
      "${ti_simplelink_sdk_root}/source/ti/devices/cc35xx/driverlib/lib/gcc/driverlib.a",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/lib/gcc/wifi_platform_cc35xx.lib",
      "${ti_simplelink_sdk_root}/source/ti/net/wifi_stack/lib/gcc/wifi_stack.lib",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/wifi_host_driver/lib/gcc/wifi_host_driver.lib",
      "${ti_simplelink_sdk_root}/source/third_party/hostap/lib/gcc/hostap.lib",
      "${ti_simplelink_sdk_root}/source/ti/net/ble_interface/lib/gcc/ble_interface.lib",
          ]
    include_dirs = [
      "${ti_simplelink_sdk_root}/source/ti/devices/cc35xx/inc",
      "${ti_simplelink_sdk_root}/source/ti/devices/cc35xx/driverlib",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/wifi_host_driver/inc_adapt",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/wifi_host_driver/inc_common",
      "${ti_simplelink_sdk_root}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/inc_common",
      "${ti_simplelink_sdk_root}/source/ti/net/wifi_stack/inc_common",
    ]

    ldflags = ["-fno-lto"]
  }

  config("cc35xx_ble_config"){
    defines = []

    libs = [
      "{ti_simplelink_sdk_root}/source/third_party/nimble/lib/ble_host_nimble.lib",
      "{ti_simplelink_sdk_root}/source/ti/net/ble_interface/lib/ble_interface.lib",
    ]
    include_dirs = [
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/host/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/host/services/dis/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/host/services/gap/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/host/services/gatt/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/host/util/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/nimble/transport/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/nimble-src/porting/nimble/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/ti-config/nimble-port/include",
      "{ti_simplelink_sdk_root}/source/third_party/nimble/ti-config/nimble-port/porting/npl/osi/include",
      "{ti_simplelink_sdk_root}/source/ti/net/ble_interface/inc_adapt",
      "{ti_simplelink_sdk_root}/source/ti/net/ble_interface/inc_common",
    ]
  }

  if (ti_simplelink_device_family == "cc13x4_26x4") {
    config("external_library_config") {
      libs = [
        "${target_gen_dir}/drivers_${ti_simplelink_soc_family}.a",
        "${target_gen_dir}/driverlib." + driverlibExt,
      ]
    }

    group("external_library") {
      public_configs = [ ":external_library_config" ]
      deps = [ ":build_external_library" ]
    }
  }

  if (ti_simplelink_device_family == "cc27xx") {
    config("external_library_config") {
      libs = [
        "${target_gen_dir}/drivers_${ti_simplelink_soc_family}.a",
        "${target_gen_dir}/driverlib." + driverlibExt,
      ]

      if(ti_simplelink_board == "LP_EM_CC2745R10_Q1"){
        libs += [ "${target_gen_dir}/secure_drivers_cc27xxx10.a" ,"${target_gen_dir}/hsmddk_cc27xxx10_its.a" ]
      } else if (ti_simplelink_board == "LP_EM_CC2755P20"){
        libs += [ "${target_gen_dir}/secure_drivers_cc27xxx20.a" ,"${target_gen_dir}/hsmddk_cc27xxx20_its.a" ]
      }
    }

    group("external_library") {
      public_configs = [ ":external_library_config" ]
      deps = [ ":build_external_library" ]
    }
  }

  config("${sdk_target_name}_config") {
    include_dirs = []

    # temporary workaround to find ble_cs.h in the Matter repo
    if (ti_simplelink_device_family == "cc27xx") {
      include_dirs += [
        "${chip_root}/src/platform/ti/cc27xx",
      ]
    }

    include_dirs += [
      "${ti_simplelink_sdk_root}/source",
      "${ti_simplelink_sdk_root}/source/third_party/CMSIS/Include",
    ]

    if (ti_simplelink_device_family == "cc13x4_26x4" || ti_simplelink_device_family == "cc32xx" ||
        ti_simplelink_device_family == "cc27xx") {
      include_dirs += [
       "${chip_root}/third_party/mbedtls/repo/include",
      ]
    } else if (ti_simplelink_device_family == "cc35xx") {
      include_dirs += [
        "${chip_root}/third_party/ti_simplelink_sdk/repo_mbedtls_cc35xx/repo/include",
      ]
    }

    if (defined(invoker.include_dirs)) {
      include_dirs += invoker.include_dirs
    }

    configs = [ ":${ti_simplelink_device_family}_sdk_config" ]
  }

  source_set("${sdk_target_name}_dpl") {
    defines = []
    include_dirs = []

    cflags = [ "-Wno-sign-compare" ]

    sources = [
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/AppHooks_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/DebugP_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/MutexP_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/QueueP_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/SemaphoreP_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/StaticAllocs_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/SwiP_freertos.c",
      "${ti_simplelink_sdk_root}/kernel/freertos/dpl/SystemP_freertos.c",
    ]
    if (ti_simplelink_device_family == "cc13x4_26x4") {
      sources += [
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/ClockPCC26X2_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/HwiPCC26X2_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/PowerCC26X2_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/TimerPCC26XX_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/startup/startup_cc13x4_cc26x4_gcc.c",
        "${ti_simplelink_sdk_root}/source/ti/drivers/sha2/SHA2CC26X2.c",
      ]
    } else if (ti_simplelink_device_family == "cc32xx") {
      sources += [
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/ClockP_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/HwiPCC32XX_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/PowerCC32XX_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/startup/startup_cc32xx_gcc.c",
        "${freertos_root}/repo/portable/MemMang/heap_4.c",
      ]
    } else if (ti_simplelink_device_family == "cc27xx") {
      include_dirs += [
        "${ti_simplelink_sdk_root}/kernel/freertos/",
        "${ti_simplelink_sdk_root}/kernel/freertos/exception",
      ]

      sources += [
        "${chip_root}/src/platform/ti/startup.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/ClockPLPF3_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/EventP_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/HwiPCC27XX_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/PowerCC27XX_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/TimestampPLPF3_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/exception/ExceptionArmV8M.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/startup/startup_cc27xx_gcc.c",
        "${ti_simplelink_sdk_root}/source/ti/drivers/sha2/SHA2LPF3SW.c",
      ]
    }
    else if (ti_simplelink_device_family == "cc35xx") {
      sources += [
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/ClockPWFF3_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/HwiPWFF3_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/PowerWFF3_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/MessageQueueP_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/dpl/TaskP_freertos.c",
        "${ti_simplelink_sdk_root}/kernel/freertos/startup/startup_cc35xx_gcc.c",   
        "${ti_simplelink_sdk_root}/source/third_party/freertos/portable/MemMang/heap_4.c", 
      ]
    }
