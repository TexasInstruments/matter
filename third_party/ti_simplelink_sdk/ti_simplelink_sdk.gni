        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_rssi_monitor.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_connection_handover.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_legacy_cmd.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_health_check.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_adv_conn.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_adv_nconn.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_ae.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_adaptivity.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_past_sender.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_past_receiver.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_ble_health.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_dmm.c",
        "${ti_simplelink_sdk_root}/source/ti/ble/stack_util/lib_opt/src/ctrl_opt_dmm_dynamic_priority.c",
      ]


      if (silk_logging_UART_enabled) {
        sources += [ "${ti_simplelink_sdk_root}/source/ti/log/LogSinkUART.c" ]
      }
      if (silk_logging_ITM_enabled) {
        sources += [ "${ti_simplelink_sdk_root}/source/ti/log/LogSinkITM.c" ]
      }
      if (silk_logging_TRACE_enabled) {
        sources +=
            [ "${ti_simplelink_sdk_root}/source/ti/log/LogSinkTraceLPF3.c" ]
      }

      configs -= [ "${build_root}/config/compiler:std_default" ]
      configs += [ ":${sdk_target_name}_posix_config" ]

      public_deps = [
        "${chip_root}/third_party/ti_simplelink_sdk:freertos",
        "${chip_root}/third_party/ti_simplelink_sdk:ti_simplelink_sysconfig",
      ]

      public_configs = [
        ":${sdk_target_name}_config",
        ":${sdk_target_name}_${ti_simplelink_device_family}_dmm_config",
        "${chip_root}/third_party/openthread/platforms/ti:openthread_ti_config",
      ]
    }
  }

  group(sdk_target_name) {
    public_deps = [
      ":${sdk_target_name}_dpl",
      ":${sdk_target_name}_freertos",
      "${openthread_root}/src/core:libopenthread_core_headers",
    ]
    if (ti_simplelink_device_family == "cc13x4_26x4") {
      public_deps += [
        ":${sdk_target_name}_dmm",
        ":${sdk_target_name}_nvocmp",
        ":build_external_library",
      ]
    } else if (ti_simplelink_device_family == "cc27xx") {
      public_deps += [
        ":${sdk_target_name}_dmm",
        ":${sdk_target_name}_nvocmp",
        ":build_external_library",
      ]
    }
    if(ti_simplelink_device_family == "cc35xx"){
      public_deps += [
        ":${sdk_target_name}_nvocmp",
        ":${sdk_target_name}_hif",
      ]
    }
    if (defined(invoker.public_configs)) {
      public_configs = invoker.public_configs
      if (ti_simplelink_device_family == "cc13x4_26x4" ||
          ti_simplelink_device_family == "cc27xx") {
        public_configs += [ ":external_library_config" ]
      }
    }
  }
}

template("freertos_target") {
  freertos_target_name = target_name

  if (ti_simplelink_device_family == "cc13x4_26x4" || ti_simplelink_device_family == "cc35xx" ||
      ti_simplelink_device_family == "cc27xx") {
    _freertos_root = "${freertos_root}"
  } else {
    _freertos_root = "${freertos_root}/repo"
  }

  config("${freertos_target_name}_config") {
    include_dirs = [ "${_freertos_root}/include" ]
  }

  source_set(freertos_target_name) {
    forward_variables_from(invoker, "*")

    if (!defined(sources)) {
      sources = []
    }

    sources += [
      "${_freertos_root}/croutine.c",
      "${_freertos_root}/event_groups.c",
      "${_freertos_root}/list.c",
      "${_freertos_root}/queue.c",
      "${_freertos_root}/stream_buffer.c",
      "${_freertos_root}/tasks.c",
      "${_freertos_root}/timers.c",
    ]

    if (!defined(configs)) {
      configs = []
    }

    if (!defined(public_configs)) {
      public_configs = []
    }

    public_configs += [ ":${freertos_target_name}_config" ]
  }
}

if(ti_simplelink_device_family == "cc35xx"){
  template("mbedtls_target") {
    mbedtls_target_name = target_name

    _mbedtls_root = "${mbedtls_repo}/repo"

    config("${mbedtls_target_name}_warnings") {
      cflags = [
        "-Wno-maybe-uninitialized",
        "-Wno-string-concatenation",
        "-Wno-unused-but-set-parameter",
        "-Wno-format-nonliteral",  # Because of mbedtls_debug_print_msg
        "-Wno-conversion",  # Lots of -Wconversion warnings, sadly.
        "-Wno-undef",  # At least MBEDTLS_AESNI_HAVE_CODE is used without being
                      # defined.
      ]

      if (is_clang) {
        cflags += [
          "-Wno-shorten-64-to-32",
          "-Wno-unused-but-set-variable",  # bignum.c: variable 't' set but not
                                          # used
        ]
      }
    }

    config("${mbedtls_target_name}_config") {
      include_dirs = [ "${_mbedtls_root}/include" ]
    }

    static_library(mbedtls_target_name) {
      forward_variables_from(invoker, "*")

      if (!defined(sources)) {
        sources = []
      }

      sources += [
        "${_mbedtls_root}/library/aes.c",
