import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/openthread.gni")
import("//build_overrides/ti_simplelink_sdk.gni")

import("${build_root}/config/defaults.gni")

import("${chip_root}/src/platform/device.gni")

import("${ti_simplelink_sdk_build_root}/ti_simplelink_executable.gni")
import("${ti_simplelink_sdk_build_root}/ti_simplelink_sdk.gni")

assert(current_os == "freertos")

project_dir = "${chip_root}/ti_examples/lighting-app/cc13x4_26x4"

ti_simplelink_sdk("sdk") {
  include_dirs = [ "${project_dir}/include" ]
  public_configs = [ ":lighting_app_config" ]
}

ti_sysconfig("sysconfig") {
  if (ti_simplelink_board == "LP_EM_CC2674P10") {
    sources = [ "${project_dir}/chip_cc2674p10.syscfg" ]
  } else if (ti_simplelink_board == "LP_EM_CC1354P10_6") {
    sources = [ "${project_dir}/chip_cc1354p10_6.syscfg" ]
  } else if (ti_simplelink_board == "LP_EM_CC1354P10_1") {
    sources = [ "${project_dir}/chip_cc1354p10_1.syscfg" ]
  } else if (ti_simplelink_board == "CC2674R10") {
    sources = [ "${project_dir}/chip_cc2674r10.syscfg" ]
  } else {
    error("Board not supported")
  }

  outputs = [
    "ti_radio_config.c",
    "ti_radio_config.h",
    "ti_drivers_config.c",
    "ti_drivers_config.h",
    "ti_ble_config.c",
    "ti_ble_config.h",
    "ti_dmm_application_policy.c",
    "ti_dmm_application_policy.h",

    # CCFG generation disabled for OTA-able application
    #"ti_devices_config.c",
    #"ti_devices_config.h",
  ]

  if (silk_logging_enabled) {
    outputs += [ "ti_log_config.c" ]
  }

  public_configs = [ ":sdk_cc13x4_26x4_dmm_config" ]

  cflags = [
    "-Wno-comment",
    "@" + rebase_path("${target_gen_dir}/sysconfig/ti_utils_build_compiler.opt",
                      root_build_dir),
  ]
}

ti_simplelink_executable("lighting_app") {
  output_name = "chip-${ti_simplelink_board}-lighting-example.out"

  sources = [
    "${chip_root}/examples/providers/DeviceInfoProviderImpl.cpp",
    "${chip_root}/src/app/clusters/general-diagnostics-server/GenericFaultTestEventTriggerHandler.cpp",
    "${project_dir}/src/AppTask.cpp",
    "${project_dir}/src/LightingManager.cpp",
    "${project_dir}/src/ZclCallbacks.cpp",
    "${project_dir}/src/main.cpp",
  ]

  if (appoble_enabled) {
    sources += [
      "${project_dir}/src/AppoBLE.cpp",
      "${project_dir}/src/diagnosticService.c",
      "${project_dir}/src/lightingService.c",
      "${project_dir}/src/throughputService.c",
    ]
  }

  if (enable_appoble_ota) {
    sources += [
      "${project_dir}/src/oad_profile.c",
      "${project_dir}/src/oad_service.c",
      "${project_dir}/src/sw_update.c",
      "${ti_simplelink_sdk_root}/source/ti/common/cc26xx/flash_interface/external/flash_interface_ext_rtos_NVS.c",
    ]
  }

  public = [
    "${chip_root}/src/platform/cc13xx_26xx/DefaultTestEventTriggerDelegate.h",
  ]

  deps = [
    ":sdk",
    ":sysconfig",
    "${chip_root}/examples/platform/ti/cc13x4_26x4:ti-attestation-credentials",
    "${chip_root}/src/lib",
    "${chip_root}/third_party/openthread:openthread",
    "${chip_root}/ti_examples/lighting-app/lighting-common",
  ]
  defines = []
  if (custom_factory_data) {
    defines += [ "TI_FACTORY_DATA" ]
  }

  if (chip_enable_icd_server) {
    defines += [ "TI_ICD_ENABLE_SERVER" ]
  }

  if (appoble_enabled) {
    defines += [ "TI_APPOBLE_ENABLE" ]
  }

  if (enable_appoble_ota) {
    defines += [
      # MCU Boot header location
      "APP_HDR_ADDR=0x6000",

      # Only Offchip OAD/OTA supported
      "OAD_APP_OFFCHIP",

      # BLE Security requires pairing with Central
      "OAD_BLE_SECURITY",
    ]
  }

  include_dirs = [
    "${project_dir}",
    "${chip_root}/examples/providers/",
  ]

  if (enable_appoble_ota) {
    include_dirs += [
      "${chip_root}/third_party/ti_simplelink_sdk/mcuboot",
      "${chip_root}/third_party/ti_simplelink_sdk/mcuboot/mcuboot_config",
      "${ti_simplelink_sdk_root}/source/third_party/mcuboot/boot/bootutil/include",
      "${ti_simplelink_sdk_root}/source/third_party/mcuboot/boot/ti/source/mcuboot_app",
      "${ti_simplelink_sdk_root}/source/ti/common/cc26xx/flash_interface/",
    ]
  }

  cflags = [
    "-Wno-address-of-packed-member",
    "-Wno-implicit-fallthrough",
    "-Wno-sign-compare",
    "-Wconversion",
  ]

  output_dir = root_out_dir
}

group("cc13x4_26x4") {
  deps = [ ":lighting_app" ]
}

group("default") {
  deps = [ ":cc13x4_26x4" ]
}
